{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PandoDeploy": {
    "Port": 5000,
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "ImageStoragePath": "/var/lib/pandodeploy/images",
    "DatabasePath": "/var/lib/pandodeploy/pandodeploy.db",
    "Authentication": {
      "EnableMTLS": false,
      "EnableApiKeys": true,
      "ApiKeyHeader": "X-API-Key",
      "RequireClientCertificate": false
    },
    "Security": {
      "MaxImageSize": 5368709120,
      "AllowedImageTypes": ["application/x-tar", "application/gzip", "application/octet-stream"]
    }
  }
}

