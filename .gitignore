## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
nupkgs/
**/[Pp]ackages/*

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# SQLite databases
*.db
*.db-shm
*.db-wal

# PandoDeploy specific
pandodeploy.db
/var/lib/pandodeploy/

# Certificates
*.pem
*.pfx
*.crt
*.key
!example-*.pem

# Test results
TestResults/
*.trx
*.coverage

# Build outputs
artifacts/
