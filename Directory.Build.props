<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- NuGet Package Properties -->
    <Version>1.0.0</Version>
    <Authors>PandoDeploy Team</Authors>
    <Company>PandoDeploy</Company>
    <Product>PandoDeploy</Product>
    <Description>Docker deployment tool without registry dependency. Deploy Docker images directly from CI/CD to your VPS without a container registry.</Description>
    <Copyright>Copyright © 2024</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MathiasGonzalez/PandoDeploy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MathiasGonzalez/PandoDeploy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>docker;deployment;devops;cli;aspnetcore;mtls;cicd</PackageTags>
    <PackageReleaseNotes>Initial release of PandoDeploy</PackageReleaseNotes>
    
    <!-- Build Configuration -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

